<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows Forms app. If you have another .NET SDK, change this (e.g. net6.0-windows, net7.0-windows). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Backprop</RootNamespace>
    <AssemblyName>BackpropActivity</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- unused private fields in the given engine classes only cause harmless warnings -->
    <NoWarn>CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="data\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
